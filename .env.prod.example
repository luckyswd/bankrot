# Шаблон боевого окружения. На сервере скопировать в .env.prod и заполнить.
# Файл НЕ попадает ни в git, ни в rsync, ни в образ — секреты живут только на сервере.
#
#   cp .env.prod.example .env.prod && nano .env.prod

# Имя проекта docker compose. Обязательно отличное от «bankrot»: без него
# compose берёт имя из каталога, а у стека разработки оно ровно такое —
# запуск боевого профиля пересоздал бы контейнеры разработки вместо своих.
COMPOSE_PROJECT_NAME=bankrot-prod

# Порт на 127.0.0.1, куда проксирует хостовый nginx.
# Занятые соседями: 8091 (promo), 8092 (raschetnik), 8093 (alimenty).
# Перед запуском проверить:
#   ss -ltnp | grep 8094
HTTP_PORT=8094

# MySQL — пароли сгенерировать, например: openssl rand -hex 24
MYSQL_DATABASE=bankruptcy
MYSQL_USER=bankruptcy
MYSQL_PASSWORD=ЗАМЕНИТЬ
MYSQL_ROOT_PASSWORD=ЗАМЕНИТЬ

# Symfony: openssl rand -hex 32
# ВАЖНО: не переносить значение из backend/.env — оно лежит в git открытым текстом.
APP_SECRET=ЗАМЕНИТЬ

# Пароль к паре ключей JWT: openssl rand -hex 32
# Задаётся ДО первого «make prod-jwt-gen»: ключи шифруются именно им.
# Смена пароля после генерации сделает выданные токены непроверяемыми.
JWT_PASSPHRASE=ЗАМЕНИТЬ

# Домен, с которого разрешены запросы к API. Фронтенд и API живут на одном
# origin, поэтому CORS в норме не задействован — значение нужно на случай
# обращения к API со стороны.
CORS_ALLOW_ORIGIN=https://bankrot.shefcode.tech

# Кому Symfony верит в заголовках X-Forwarded-*. REMOTE_ADDR — непосредственный
# прокси, то есть контейнерный nginx. Без этого приложение считает запросы
# незащищёнными и видит адрес прокси вместо адреса посетителя.
TRUSTED_PROXIES=REMOTE_ADDR
